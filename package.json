{
  "name": "@hammotime/eve-online-mcp-lib",
  "version": "0.0.0",
  "description": "Runtime-independent read-only EVE Online MCP core",
  "keywords": [
    "eve-online",
    "esi",
    "mcp",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HammoTime/eve-online-mcp-lib.git"
  },
  "homepage": "https://github.com/HammoTime/eve-online-mcp-lib",
  "bugs": {
    "url": "https://github.com/HammoTime/eve-online-mcp-lib/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "openapi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:runtime && npm test && npm run build && npm run check:bundle",
    "typecheck:runtime": "tsc -p tsconfig.runtime.json --noEmit",
    "check:bundle": "esbuild src/server.ts --bundle --platform=browser --format=esm --outfile=dist/browser-check.js",
    "diagnostics:export": "tsx adapters/diagnostics-cli.ts export",
    "diagnostics:replay": "tsx adapters/diagnostics-cli.ts replay"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "jose": "^6.2.12",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/otlp-transformer": "^0.219.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  }
}
